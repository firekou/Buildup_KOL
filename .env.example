# Dashboard 環境變數。Railway 上在 service 的 Variables 分頁設定；
# 本機開發把這個檔案複製成 .env 並自行載入（或直接 export）。

# HTTP port。Railway 會自動注入，本機預設 8080。
PORT=8080

# 評估記錄的寫入位置。
# Railway 的容器檔案系統是暫存的——沒有掛 volume 的話，重新部署就會清空。
# 掛一個 Railway Volume（例如掛載到 /data）後把這個變數指到掛載點。
DATA_DIR=/data

# --- Apify（地區話題資料來源）---------------------------------------
# 沒設 APIFY_TOKEN 時，Dashboard 會改用 dashboard/server/lib/topics/fixtures.js
# 裡的手寫範例資料，並在畫面上標示「範例資料」。功能可用，但數字不是真的。
APIFY_TOKEN=

# 各平台使用的 actor，可換不換程式。
APIFY_ACTOR_THREADS=curious_coder~threads-scraper
APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
APIFY_ACTOR_INSTAGRAM=apify~instagram-hashtag-scraper

# 話題結果的快取秒數（預設 1800 = 30 分鐘）。
TOPIC_CACHE_TTL_SECONDS=1800

# 單次 Apify 呼叫的逾時毫秒數，逾時後退回範例資料。
APIFY_TIMEOUT_MS=90000

# --- AI Token King MCP（開發工具，非 Dashboard 執行期需要）---------------
# .mcp.json 用 ${AITOKENKING_API_KEY} 展開，key 不進 repo。
# 這一項不需要設在 Railway——它只給本機 / CI 的 MCP client 用。
# 取得方式：https://www.aitokenking.com.tw/ 後台
AITOKENKING_API_KEY=
