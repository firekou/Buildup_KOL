# Dashboard 環境變數。Railway 上在 service 的 Variables 分頁設定；
# 本機開發把這個檔案複製成 .env 並自行載入（或直接 export）。

# HTTP port。Railway 會自動注入，本機預設 8080。
PORT=8080

# 評估記錄的寫入位置。
# Railway 的容器檔案系統是暫存的——沒有掛 volume 的話，重新部署就會清空。
# 掛一個 Railway Volume（例如掛載到 /data）後把這個變數指到掛載點。
DATA_DIR=/data

# --- Apify（地區話題資料來源）---------------------------------------
# 沒設 APIFY_TOKEN 時，Dashboard 會改用 dashboard/server/lib/topics/fixtures.js
# 裡的手寫範例資料，並在畫面上標示「範例資料」。功能可用，但數字不是真的。
APIFY_TOKEN=

# 各平台使用的 actor，可換不換程式。
APIFY_ACTOR_THREADS=curious_coder~threads-scraper
APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
APIFY_ACTOR_INSTAGRAM=apify~instagram-hashtag-scraper

# 話題結果的快取秒數（預設 1800 = 30 分鐘）。
TOPIC_CACHE_TTL_SECONDS=1800

# 單次 Apify 呼叫的逾時毫秒數，逾時後退回範例資料。
APIFY_TIMEOUT_MS=90000

# --- AI Token King MCP（開發工具，非 Dashboard 執行期需要）---------------
# .mcp.json 用 ${AITOKENKING_API_KEY} 展開，key 不進 repo。
# 這一項不需要設在 Railway——它只給本機 / CI 的 MCP client 用。
# 取得方式：https://www.aitokenking.com.tw/ 後台
AITOKENKING_API_KEY=

# --- Growth Hack OS ---------------------------------------------------
# GHOS 與既有 Dashboard 共用同一個 service 與同一個 DATA_DIR；資料放在
# ${DATA_DIR}/growth/ 底下。沒有掛 volume 時一樣能跑，但重新部署就會清空，
# Dashboard 會在頂端標示「資料為暫存」。

# 生成成本換算用的 credit 方案。影響 cost ledger 的美金金額，不影響 credit 數。
# 可選：ultra-3000-monthly（預設）/ ultra-9000-annual / ultra-9000-monthly
# 單價來源：costs/video-generation-costs.md 的實際帳單記錄。
GHOS_CREDIT_PLAN=ultra-3000-monthly

# 轉換歸因窗（小時）。超過這個時間的點擊不再與轉換 join。預設 168（7 天）。
GHOS_ATTRIBUTION_WINDOW_HOURS=168

# --- 生成 adapter 憑證（皆為選填）--------------------------------------
# 都不設也能跑完整閉環：內建的 template adapter 不呼叫任何外部模型、成本為 0，
# 影片／圖片則走「外部生成後登錄素材與成本」的流程。
#
# AITOKENKING_API_KEY 已在上方定義（MCP 用），Growth OS 的文案生成 adapter
# 會共用同一把 key。
HIGGSFIELD_API_KEY=
OPENAI_API_KEY=

# --- 社群帳號憑證 ------------------------------------------------------
# 這裡不放任何實際 token。social_accounts 只存 credentialRef（環境變數名稱），
# 真正的值由 Railway 的 service variables 提供，並且目前沒有任何 adapter 會
# 讀它們——所有平台都是「人工發布後登錄結果」。要改成自動發布時，才在對應的
# publisher adapter 裡讀取。
